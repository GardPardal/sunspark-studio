{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://dwwospznutfbxcbbcqfa.supabase.co/auth/v1",
    "accepted_audiences": ["authenticated"]
  },
  "mcp": {
    "server": {
      "name": "lz7-crm-mcp",
      "version": "0.1.0",
      "title": "LZ7 Energia CRM"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Quem sou eu",
        "description": "Retorna dados do usuário autenticado no painel LZ7 (id, email, unidade, papéis).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_my_leads",
        "title": "Listar meus leads",
        "description": "Lista os leads atribuídos ao consultor autenticado. Suporta filtro por estágio e limite.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "stage": {
              "description": "Filtrar por estágio do funil (opcional).",
              "type": "string",
              "enum": ["novo", "atendimento", "nao_atendido", "venda", "faturado", "perdido"]
            },
            "limit": {
              "description": "Máximo de leads (padrão 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_lead",
        "title": "Ver detalhes do lead",
        "description": "Retorna todos os campos de um lead pelo id. Sujeito às políticas de RLS do usuário.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID do lead"
            }
          },
          "required": ["id"]
        },
        "outputSchema": null
      },
      {
        "name": "create_lead",
        "title": "Criar lead",
        "description": "Cria um novo lead no CRM, atribuído ao usuário autenticado. Use quando o consultor informar um contato novo.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "nome": {
              "type": "string",
              "minLength": 1
            },
            "telefone": {
              "type": "string",
              "minLength": 1
            },
            "email": {
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "cidade": {
              "type": "string"
            },
            "estado": {
              "type": "string"
            },
            "valor_conta": {
              "description": "Valor médio da conta de luz, em reais (texto).",
              "type": "string"
            },
            "mensagem": {
              "type": "string"
            },
            "origem": {
              "description": "Ex: indicação, whatsapp, mcp",
              "type": "string"
            }
          },
          "required": ["nome", "telefone"]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_appointments",
        "title": "Listar meus compromissos",
        "description": "Lista compromissos da agenda do usuário autenticado em uma janela de datas.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Data inicial ISO (ex: 2026-07-20)."
            },
            "to": {
              "type": "string",
              "description": "Data final ISO (ex: 2026-07-27)."
            }
          },
          "required": ["from", "to"]
        },
        "outputSchema": null
      },
      {
        "name": "create_appointment",
        "title": "Criar compromisso na agenda",
        "description": "Agenda um novo compromisso (visita, ligação, reunião) para o consultor autenticado. Datas em ISO 8601.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "starts_at": {
              "type": "string",
              "description": "Início em ISO 8601 (ex: 2026-07-21T14:00:00-03:00)"
            },
            "ends_at": {
              "type": "string",
              "description": "Fim em ISO 8601"
            },
            "type": {
              "type": "string",
              "enum": ["visita", "ligacao", "reuniao", "outros"]
            },
            "lead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": ["title", "starts_at", "ends_at"]
        },
        "outputSchema": null
      },
      {
        "name": "dashhub_get",
        "title": "Ler dados da Sala de Comando",
        "description": "Retorna o pacote de dados atual exibido na página /dashhub (Sala de Comando), com origem e data da última atualização.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "dashhub_update",
        "title": "Editar dados da Sala de Comando",
        "description": "Atualiza o pacote de dados da página /dashhub. Por padrão faz merge no primeiro nível (chaves ausentes são preservadas); use mode='replace' para substituir tudo. A versão anterior é sempre salva no histórico.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "dados": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Objeto JSON com as chaves a gravar. Objeto vazio não altera nada."
            },
            "mode": {
              "description": "merge (padrão) ou replace.",
              "type": "string",
              "enum": ["merge", "replace"]
            },
            "origem": {
              "description": "Quem fez a alteração (ex: claude-mcp).",
              "type": "string",
              "maxLength": 200
            }
          },
          "required": ["dados"]
        },
        "outputSchema": null
      },
      {
        "name": "dashhub_get_app",
        "title": "Ler o painel da Sala de Comando (HTML/CSS/JS)",
        "description": "Retorna o painel atual da página /dashhub: as partes css, body e js guardadas em dados.APP. Use parte='css'|'body'|'js' para pegar só um pedaço (evita respostas gigantes). Sem parte, retorna apenas o tamanho de cada pedaço.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "parte": {
              "description": "Qual pedaço retornar. Omita para ver só os tamanhos.",
              "type": "string",
              "enum": ["css", "body", "js"]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "dashhub_set_app",
        "title": "Editar o painel da Sala de Comando (HTML/CSS/JS)",
        "description": "Reescreve o painel da página /dashhub. Envie css, body e/ou js — o que não for enviado permanece igual. body é o HTML interno da página (sem <html>/<head>/<body>), css é CSS puro (sem <style>) e js é JavaScript puro (sem <script>), que pode ler os números em window.__HUB_DADOS. A versão anterior é sempre salva no histórico.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "css": {
              "description": "CSS puro, sem a tag <style>.",
              "type": "string",
              "maxLength": 400000
            },
            "body": {
              "description": "HTML interno da página, sem <html>/<body>.",
              "type": "string",
              "maxLength": 400000
            },
            "js": {
              "description": "JavaScript puro, sem a tag <script>.",
              "type": "string",
              "maxLength": 400000
            },
            "origem": {
              "description": "Quem alterou (ex: claude-mcp).",
              "type": "string",
              "maxLength": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_site_pages",
        "title": "Listar páginas do site",
        "description": "Lista as páginas editáveis do site público (CMS): slug, título, se está publicada e data de atualização.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Máximo de páginas (padrão 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_site_page",
        "title": "Ver página do site",
        "description": "Retorna o conteúdo completo (markdown/HTML) e SEO de uma página do site pelo slug.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug da página, ex: sobre"
            }
          },
          "required": ["slug"]
        },
        "outputSchema": null
      },
      {
        "name": "upsert_site_page",
        "title": "Criar ou editar página do site",
        "description": "Cria ou atualiza uma página do site público (CMS) pelo slug. Campos omitidos permanecem como estão quando a página já existe.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Slug da página, ex: sobre"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "subtitle": {
              "type": "string"
            },
            "content": {
              "description": "Conteúdo da página (markdown/HTML).",
              "type": "string"
            },
            "published": {
              "type": "boolean"
            },
            "seo": {
              "description": "Objeto de SEO (title, description...)",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": ["slug"]
        },
        "outputSchema": null
      },
      {
        "name": "admin_query",
        "title": "Consultar banco (admin)",
        "description": "Executa uma consulta SELECT/WITH em qualquer tabela do Solar OS e retorna JSON. Disponível apenas para usuários com papel admin. Toda chamada é auditada.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 6,
              "description": "Consulta SQL somente leitura (SELECT ou WITH), sem ponto e vírgula final."
            }
          },
          "required": ["sql"]
        },
        "outputSchema": null
      },
      {
        "name": "admin_execute",
        "title": "Alterar dados (admin)",
        "description": "Executa INSERT/UPDATE/DELETE (ou DDL) no banco do Solar OS. Disponível apenas para usuários com papel admin. Toda chamada é auditada. Use com cuidado: as alterações são permanentes.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "sql": {
              "type": "string",
              "minLength": 6,
              "description": "Comando SQL de escrita. Sempre inclua WHERE em UPDATE/DELETE."
            },
            "confirm": {
              "type": "boolean",
              "const": true,
              "description": "Confirmação explícita de que a alteração deve ser aplicada."
            }
          },
          "required": ["sql", "confirm"]
        },
        "outputSchema": null
      }
    ]
  }
}
