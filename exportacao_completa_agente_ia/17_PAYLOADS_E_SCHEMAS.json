  "webhook_zapi_recebimento": {
    "metodo": "POST",
    "rota": "/api/public/whatsapp/zapi",
    "autenticacao": "token no header; sem token retorna 403",
    "idempotencia": "hash do evento + messageId",
    "exemplo_payload": {
      "isStatusReply": false,
      "instanceId": "<INSTANCE_ID>",
      "messageId": "AAAAAAAAAAAAAAAAAAAA",
      "phone": "5543999990000",
      "fromMe": false,
      "momment": 1757600000000,
      "status": "RECEIVED",
      "chatName": "Cliente Exemplo",
      "senderName": "Cliente Exemplo",
      "senderPhoto": "https://exemplo/foto.jpg",
      "participantLid": null,
      "text": { "message": "Oi, queria um orcamento de energia solar" }
    },
    "campos_criticos": {
      "status": "RECEIVED indica mensagem recebida, nao status de entrega",
      "text.message": "local real do texto",
      "participantLid": "identificador sem telefone; quando presente e phone ausente, exibir ID curto e NUNCA fabricar telefone"
    }
  },

  "webhook_zapi_status": {
    "exemplo_payload": {
      "instanceId": "<INSTANCE_ID>",
      "ids": ["AAAAAAAAAAAAAAAAAAAA"],
      "phone": "5543999990000",
      "status": "READ",
      "momment": 1757600005000
    },
    "regra": "aplicacao monotonica: SENT < DELIVERED < READ; status anterior nunca sobrescreve status mais avancado"
  },

