{
  "manifest_version": 3,
  "name": "LZ7 · WhatsApp → Ploomes",
  "version": "1.3.0",
  "description": "Botão no cabeçalho do WhatsApp Web: lê a conversa (nome, cidade, conta de luz, fatura, código do anúncio) e cadastra o lead no Solar OS, no Ploomes (Comercial) e na Meta pelo formulário da SDR.",
  "icons": {
    "128": "icone.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lz7energia.com.br/sdr-leadqualified*",
        "https://www.lz7energia.com.br/sdr-leadqualified*"
      ],
      "js": [
        "formulario.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "incognito": "spanning"
}